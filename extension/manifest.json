{
  "manifest_version": 3,
  "name": "Web Goal Finder",
  "version": "0.2.0",
  "description": "Give a goal and let Jev perform it on the current page, or save the page state to Downloads/web-snap.",
  "permissions": ["activeTab", "scripting", "downloads", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Web Goal Finder", "default_popup": "popup.html" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Open Web Goal Finder"
    },
    "save-snapshot": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save the state of the current page"
    }
  }
}
