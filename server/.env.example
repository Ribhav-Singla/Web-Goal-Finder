# Copy to .env. .env is ignored by git.
OPENROUTER_API_KEY=
# Any OpenRouter model id. typesafe/jev-router picks a model for each request.
JEV_MODEL=typesafe/jev-router
# Keys the React component may send (comma separated). Make up your own, e.g. pk_myapp_8f3k2...
CLIENT_KEYS=pk_dev_change_me
# Sites allowed to call this server (comma separated).
ALLOWED_ORIGINS=http://localhost:5173
PORT=8765
